---
import Base from '../../layouts/Base.astro';
import { cases, type Case } from '../../data/cases';

export function getStaticPaths() {
  return cases.map((c, i) => ({ params: { slug: c.slug }, props: { c, next: cases[(i + 1) % cases.length] } }));
}
interface Props { c: Case; next: Case }
const { c, next } = Astro.props;
const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>';
---
<Base title={`${c.title} · 刘晓东`} description={c.summary} solidNav>
  <header class="top dark">
    <div class="wrap">
      <a class="back" href="/#cases">← 全部案例</a>
      <div class="meta">
        <span class="no serif">{c.no}</span>
        <span class="tag mono">{c.tag}</span>
      </div>
      <h1>{c.title}</h1>
      <p class="summary">{c.summary}</p>
      <p class="env mono">{c.env}</p>
    </div>
  </header>

  <div class="wrap body">
    <article>
      <section>
        <h2>背景与目标</h2>
        {c.background.map((p) => <p>{p}</p>)}
      </section>

      <section>
        <h2>架构</h2>
        <div class="lanes">
          {c.lanes.map((lane) => (
            <div class="lane">
              <div class="lane-label mono">{lane.label}</div>
              <ol class="lane-nodes">
                {lane.nodes.map((n) => (
                  <li class:list={{ accent: n.accent }}>
                    <b>{n.name}</b>
                    {n.sub && <small>{n.sub}</small>}
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2>关键做法</h2>
        <ol class="steps">
          {c.steps.map((s, i) => (
            <li>
              <span class="i mono">{String(i + 1).padStart(2, '0')}</span>
              <div><h3>{s.title}</h3><p>{s.text}</p></div>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h2>遇到的问题</h2>
        <div class="issues">
          {c.issues.map((x) => (
            <div class="issue">
              <p class="sym">{x.symptom}</p>
              <dl>
                <dt>原因</dt><dd>{x.cause}</dd>
                <dt>解决</dt><dd>{x.fix}</dd>
              </dl>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2>结果</h2>
        <ul class="results">{c.results.map((r) => <li>{r}</li>)}</ul>
      </section>
    </article>

    <aside>
      <div class="side">
        <h2 class="side-h">技术栈</h2>
        <ul class="stack">{c.stack.map((t) => <li>{t}</li>)}</ul>
        {c.links && (
          <>
            <h2 class="side-h">公开代码</h2>
            <ul class="links">
              {c.links.map((l) => (
                <li><a href={l.href} target="_blank" rel="noopener">{l.label}<small class="mono">{l.href.replace('https://', '')}</small></a></li>
              ))}
            </ul>
          </>
        )}
        <a class="next" href={`/cases/${next.slug}/`}>
          <small>下一个案例</small>
          <b>{next.title}</b>
          <Fragment set:html={arrow} />
        </a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .top { background: radial-gradient(900px 400px at 85% 0%, #15294a, transparent 65%), var(--navy-900); color: var(--on-dark); padding: 136px 0 72px; }
  .back { font-size: 14px; color: var(--on-dark-3); text-decoration: none; }
  .back:hover { color: var(--gold); }
  .meta { display: flex; align-items: baseline; gap: 20px; margin-top: 40px; }
  .no { font-size: 44px; line-height: 1; color: var(--gold); }
  .tag { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-dark-3); }
  h1 { font-size: clamp(30px, 4vw, 48px); line-height: 1.3; color: #fff; margin: 18px 0 20px; max-width: 860px; }
  .summary { font-size: 18px; line-height: 1.85; color: var(--on-dark-2); max-width: 760px; margin: 0; }
  .env { margin: 28px 0 0; font-size: 12px; color: var(--on-dark-3); letter-spacing: 0.04em; }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 80px; padding-top: 80px; padding-bottom: 120px; }
  article section { margin-bottom: 72px; }
  article h2 { font-size: 26px; padding-bottom: 16px; margin-bottom: 28px; border-bottom: 1px solid var(--ink); }
  article p { color: var(--ink-2); font-size: 16px; line-height: 1.95; margin: 0 0 14px; }

  /* 架构泳道 */
  .lanes { display: grid; gap: 14px; }
  .lane { display: grid; grid-template-columns: 88px 1fr; gap: 16px; align-items: center; }
  .lane-label { font-size: 12px; letter-spacing: 0.1em; color: var(--gold-ink); }
  .lane-nodes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: stretch; gap: 10px 30px; }
  .lane-nodes li {
    position: relative; min-width: 120px; padding: 12px 16px;
    background: var(--card); border: 1px solid var(--rule); border-radius: 3px;
  }
  .lane-nodes li:not(:last-child)::after {
    content: ""; position: absolute; right: -24px; top: 50%; width: 18px; height: 1px; background: var(--muted);
  }
  .lane-nodes li:not(:last-child)::before {
    content: ""; position: absolute; right: -24px; top: calc(50% - 3px); border: 3.5px solid transparent; border-left: 5px solid var(--muted); border-right: 0;
  }
  .lane-nodes li.accent { border-color: var(--gold); background: #fffaf0; }
  .lane-nodes b { display: block; font-size: 14px; font-weight: 600; }
  .lane-nodes small { display: block; font-size: 12px; color: var(--muted); margin-top: 2px; }

  /* 做法 */
  .steps { list-style: none; margin: 0; padding: 0; }
  .steps li { display: grid; grid-template-columns: 52px 1fr; gap: 8px; padding: 24px 0; border-bottom: 1px solid var(--rule); }
  .steps li:first-child { padding-top: 0; }
  .steps .i { font-size: 13px; color: var(--gold-ink); padding-top: 4px; }
  .steps h3 { font-size: 19px; margin-bottom: 8px; }
  .steps p { margin: 0; }

  /* 问题 */
  .issues { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .issue { background: var(--card); border: 1px solid var(--rule); border-top: 2px solid var(--gold); padding: 22px 24px; }
  .sym { font-weight: 600; color: var(--ink) !important; font-size: 16px !important; line-height: 1.6 !important; margin-bottom: 14px !important; }
  .issue dl { margin: 0; display: grid; grid-template-columns: 40px 1fr; gap: 8px 8px; font-size: 14px; line-height: 1.75; }
  .issue dt { color: var(--gold-ink); font-size: 13px; }
  .issue dd { margin: 0; color: var(--ink-2); }

  /* 结果 */
  .results { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
  .results li { position: relative; padding: 16px 0 16px 28px; border-bottom: 1px solid var(--rule); color: var(--ink); font-size: 16px; }
  .results li::before { content: ""; position: absolute; left: 0; top: 26px; width: 14px; height: 1px; background: var(--gold); }

  /* 侧栏 */
  .side { position: sticky; top: 104px; }
  .side-h { font-size: 13px; font-family: var(--mono); font-weight: 500; letter-spacing: 0.16em; color: var(--muted); padding-bottom: 12px; border-bottom: 1px solid var(--rule); margin-bottom: 16px; }
  .stack { list-style: none; margin: 0 0 40px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .stack li { font: 12px/1 var(--mono); padding: 8px 10px; border: 1px solid var(--rule); background: var(--card); color: var(--ink-2); }
  .links { list-style: none; margin: 0 0 40px; padding: 0; display: grid; gap: 10px; }
  .links a { display: block; padding: 14px 16px; border: 1px solid var(--rule); background: var(--card); text-decoration: none; font-size: 14px; font-weight: 500; }
  .links a:hover { border-color: var(--gold); }
  .links small { display: block; margin-top: 4px; font-size: 11px; color: var(--muted); font-weight: 400; }
  .next { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 4px 12px; padding: 22px; background: var(--navy-900); color: var(--on-dark); text-decoration: none; border-radius: 3px; }
  .next small { grid-column: 1 / -1; font-size: 12px; color: var(--on-dark-3); letter-spacing: 0.08em; }
  .next b { font: 600 17px/1.5 var(--serif); }
  .next :global(svg) { color: var(--gold); transition: transform 0.25s; }
  .next:hover :global(svg) { transform: translateX(4px); }

  @media (max-width: 960px) {
    .body { grid-template-columns: 1fr; gap: 24px; }
    .side { position: static; }
    .issues, .results { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .top { padding: 112px 0 56px; }
    .body { padding-top: 56px; padding-bottom: 80px; }
    article section { margin-bottom: 56px; }
    .lane { grid-template-columns: 1fr; gap: 8px; }
    .lane-nodes { flex-direction: column; gap: 22px; }
    .lane-nodes li:not(:last-child)::after { right: auto; left: 24px; top: auto; bottom: -17px; width: 1px; height: 12px; }
    .lane-nodes li:not(:last-child)::before { right: auto; left: 21px; top: auto; bottom: -22px; border: 3.5px solid transparent; border-top: 5px solid var(--muted); border-bottom: 0; }
    .steps li { grid-template-columns: 40px 1fr; }
  }
</style>

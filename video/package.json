{
  "name": "liuxd-showreel",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Showreel ../site/public/video/showreel.mp4 --codec h264 --crf 26 --audio-bitrate 128k --gl=swangle",

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Asia/Shanghai",
  "schedule": [
    "before 9am on monday"
  ],
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "npm 的小版本和补丁合成一个 PR",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm minor/patch"
    },
    {
      "description": "GitHub Actions 合成一个 PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "简历 PDF 用的 playwright 单独升级：换了 Chromium 版本，排版可能变化，合并前看一眼 CI 生成的 PDF",
      "matchFileNames": [
        "resume/**"
      ],
      "groupName": "resume playwright"
    },
    {
      "description": "补丁版本（如 1.2.3 → 1.2.4）：CI 全部通过后自动合并；小版本、大版本仍然等人看",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "所有升级（包括大版本）CI 全部通过后自动合并",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    }
  ]
}
